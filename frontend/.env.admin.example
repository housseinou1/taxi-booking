# ── YALA Admin — local development (Create React App) ─────────────────────────
# Copy to .env.local (or run: npm run start:admin) so the dev server talks to
# your local Django API on port 8000, NOT production.
#
# CRITICAL: Do not set REACT_APP_API_URL to https://www.yalataxi.live for local
# work unless you intentionally test against production from your machine.
# With no REACT_APP_API_URL, frontend/src/apiConfig.js uses http://localhost:8000
# when npm runs in development on localhost.
#
# Backend: run Django with DEBUG=True from backend/taxi (default dev CORS allows
# http://localhost:3000 → http://127.0.0.1:8000).

REACT_APP_TYPE=admin

# Optional: only if the automatic localhost:8000 default does not match your setup:
# REACT_APP_API_URL=http://127.0.0.1:8000
