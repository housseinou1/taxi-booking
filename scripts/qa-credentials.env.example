# Credentials for local operator / QA / seed scripts. NO REAL VALUES IN THIS FILE.
#
# 1. Copy to scripts/qa-credentials.env (git-ignored by the "*.env" rule) and fill in locally.
#    Get values from the password manager / administrator, never from chat, tickets or git history.
# 2. Load into the current shell only:
#      bash:        set -a; . scripts/qa-credentials.env; set +a
#      PowerShell:  Get-Content scripts/qa-credentials.env | ? { $_ -match '^[A-Z0-9_]+=.' } |
#                     % { $k, $v = $_ -split '=', 2; Set-Item "env:$k" $v }
# 3. Unset when done (bash: unset ${!YALA_*} ${!RC2_*}; PowerShell: Remove-Item env:YALA_*, env:RC2_*).
#
# Keep values on the same line as the name, without quotes or trailing comments.
# Operator scripts exit with "Missing required environment variable: NAME" when a value is
# missing; they never print values. Leave a line empty if you do not run the scripts that need it.

# Production admin (CEO account). Only for scripts that explicitly need admin access.
YALA_CEO_EMAIL=
YALA_CEO_PASSWORD=

# Local admin QA roles (frontend/qa/admin-routes-auth.cjs). Set YALA_QA_ROLE=ceo|hr|finance|ops|admin.
# After `python manage.py seed_pilot_uat` with YALA_PILOT_UAT_PASSWORD set (local only):
#   ceo@pilot.yala.test, hr@pilot.yala.test, finance1@pilot.yala.test, ops1@pilot.yala.test
YALA_HR_EMAIL=
YALA_HR_PASSWORD=
YALA_FINANCE_EMAIL=
YALA_FINANCE_PASSWORD=
YALA_OPS_EMAIL=
YALA_OPS_PASSWORD=
YALA_ADMIN_EMAIL=

# Production QA accounts:
# qa-rider-profile-fix@test.local
YALA_QA_RIDER_PASSWORD=
# qa-driver-final-qa@test.local
YALA_QA_DRIVER_PASSWORD=
# qa-driver-profile-fix@test.local
YALA_QA_DRIVER2_PASSWORD=
# Legacy shared QA/demo accounts (mariam.ba, amadou.diallo, couriers, ...). Rotate to unique values.
YALA_QA_DEFAULT_PASSWORD=

# Script-specific names kept for backwards compatibility:
# scripts/sprint0_pilot_ride.py (ALT is optional)
YALA_PILOT_RIDER_PW=
YALA_PILOT_DRIVER_PW=
YALA_PILOT_DRIVER_ALT_PW=
# scripts/rc2-mobile-api-smoke.py
RC2_RIDER_PASSWORD=
RC2_DRIVER_PASSWORD=
# scripts/verify-prod-security.py and scripts/verify-prod-security-remote.sh
YALA_TEST_PASSWORD=
YALA_DRIVER_PASSWORD=
# scripts/platform-rc1-smoke.py
YALA_SMOKE_RIDER_PASSWORD=
YALA_SMOKE_DRIVER_PASSWORD=
YALA_SMOKE_ADMIN_PASSWORD=
# Other existing QA scripts
YALA_ADMIN_PASSWORD=
YALA_UAT_PASSWORD=

# Coordinated RC pilot seed (staging/local synthetic @pilot.yala.test only).
YALA_PILOT_UAT_PASSWORD=
YALA_API_URL=

# Local seed commands (backend). Optional: if unset, each run uses a random password that is
# never printed, so seeded accounts cannot log in until you set a value and re-seed.
# seed_fresh.py, seed_data.py, manage.py seed_delivery_couriers
YALA_SEED_DEFAULT_PASSWORD=
# scripts/seed_admin_driver_accounts.py
YALA_SEED_TEMP_PASSWORD=
# manage.py day_zero_simulation
YALA_SIMULATION_PASSWORD=
