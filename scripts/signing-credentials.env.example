# Copy to signing/credentials.env and fill after running scripts/generate-upload-keys.ps1
# NEVER commit signing/credentials.env

YALA_RIDER_KEYSTORE=C:/path/to/yala-release.keystore
YALA_RIDER_STORE_PASSWORD=
YALA_RIDER_KEY_ALIAS=yala-key
YALA_RIDER_KEY_PASSWORD=

YALA_DRIVER_KEYSTORE=C:/path/to/yala-release.keystore
YALA_DRIVER_STORE_PASSWORD=
YALA_DRIVER_KEY_ALIAS=yala-key
YALA_DRIVER_KEY_PASSWORD=

YALA_DELIVERY_KEYSTORE=C:/path/to/yala-delivery-upload-key.jks
YALA_DELIVERY_STORE_PASSWORD=
YALA_DELIVERY_KEY_ALIAS=yala_delivery_upload
YALA_DELIVERY_KEY_PASSWORD=
