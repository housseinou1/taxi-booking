# Copy to signing/credentials.env and fill after running scripts/generate-upload-keys.ps1
# NEVER commit signing/credentials.env

YALA_RIDER_KEYSTORE=C:/path/to/signing/yala-rider-upload.jks
YALA_RIDER_STORE_PASSWORD=
YALA_RIDER_KEY_ALIAS=yala-rider-upload
YALA_RIDER_KEY_PASSWORD=

YALA_DRIVER_KEYSTORE=C:/path/to/signing/yala-driver-upload.jks
YALA_DRIVER_STORE_PASSWORD=
YALA_DRIVER_KEY_ALIAS=yala-driver-upload
YALA_DRIVER_KEY_PASSWORD=

YALA_DELIVERY_KEYSTORE=C:/path/to/signing/yala-delivery-upload.jks
YALA_DELIVERY_STORE_PASSWORD=
YALA_DELIVERY_KEY_ALIAS=yala-delivery-upload
YALA_DELIVERY_KEY_PASSWORD=
