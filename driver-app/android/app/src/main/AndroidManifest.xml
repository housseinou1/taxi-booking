<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- DECISION 1 (approved 2026-10): Yala Driver must track location during an ACTIVE
         trip, including while the app is minimised or the screen is locked. That requires
         the @capacitor-community/background-geolocation foreground service, which the
         plugin declares with android:foregroundServiceType="location" together with
         FOREGROUND_SERVICE and FOREGROUND_SERVICE_LOCATION.

         ACCESS_BACKGROUND_LOCATION is requested here because Android 10+ requires it for
         location updates while the app is in the background. Tracking is started only when a
         trip becomes active and is stopped as soon as the trip ends (see
         frontend/src/native/location.js and the driver dashboard), so the permission is never
         used outside an active trip. Google Play therefore requires the background-location
         declaration plus an in-app disclosure. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- The @capacitor-community/background-geolocation foreground service is KEPT
             (it is declared by the plugin with android:foregroundServiceType="location").
             It is started only for the duration of an active trip. -->
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>

