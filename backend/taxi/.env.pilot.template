# YALA Pilot / UAT environment — copy to .env.pilot and fill secrets.
# NEVER reuse production secrets or production DATABASE_URL here.
#
#   cp backend/taxi/.env.pilot.template backend/taxi/.env.pilot
#
# Required by fail-closed settings when DJANGO_DEBUG=False:
#   DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS, REDIS_URL

POSTGRES_PASSWORD=change-me-pilot-postgres-password

DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.yalataxi.live

DATABASE_URL=postgres://yala_pilot:change-me-pilot-postgres-password@postgres:5432/yala_pilot_db
DATABASE_SSL_REQUIRE=False

REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,http://localhost,https://localhost
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8088

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

FRONTEND_URL=http://localhost:8088
YALA_SMS_PROVIDER=console
SENTRY_ENVIRONMENT=pilot
APP_FEE_PERCENT=30
PRIVATE_CALL_NUMBER=+22245000001
