# ═══════════════════════════════════════════════════════════════════════════════
# YALA STAGING ENVIRONMENT (vault copy → .env.staging on staging droplet only)
# ═══════════════════════════════════════════════════════════════════════════════
#
# ISOLATION RULES (enforced by policy — verify before first boot):
#   • DATABASE_URL host MUST be `postgres` (compose service) or a staging-only managed DB.
#   • MUST NOT contain: 142.93.99.142, yala_db (prod name), production Moosyl keys.
#   • PAYMENTS_LIVE_MODE=False, MOOSYL_ENVIRONMENT=sandbox
#   • Never copy .env.production from 142.93.99.142 into this file.
#
# Setup: cp env.staging.template .env.staging && fill ← REQUIRED fields

# ── DJANGO CORE ───────────────────────────────────────────────────────────────

DJANGO_SECRET_KEY=                          # ← REQUIRED (new key, not prod)
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=staging.yalataxi.live,www.staging.yalataxi.live,api-staging.yalataxi.live

# ── DATABASE ─────────────────────────────────────────────────────────────────

DATABASE_URL=postgres://yala_staging_user:CHANGE_ME@postgres:5432/yala_staging
DATABASE_SSL_REQUIRE=False

# ── REDIS / CELERY (staging-only containers) ─────────────────────────────────

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── CORS & CSRF ─────────────────────────────────────────────────────────────

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://staging.yalataxi.live,https://www.staging.yalataxi.live,https://api-staging.yalataxi.live,capacitor://localhost,http://localhost,https://localhost,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=https://staging.yalataxi.live,https://www.staging.yalataxi.live,https://api-staging.yalataxi.live

# ── HTTPS / SECURITY ─────────────────────────────────────────────────────────

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=86400
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
YALA_TRUST_X_FORWARDED_FOR=True

# ── FRONTEND ─────────────────────────────────────────────────────────────────

FRONTEND_URL=https://staging.yalataxi.live

# ── PAYMENTS / MOOSYL (SANDBOX ONLY) ─────────────────────────────────────────

PAYMENTS_LIVE_MODE=False
MOOSYL_ENVIRONMENT=sandbox
MOOSYL_ALLOW_SANDBOX_SETTLEMENT=True
MOOSYL_API_BASE_URL=https://api.moosyl.com
MOOSYL_SECRET_KEY=                          # ← sandbox vault (NOT production)
MOOSYL_PUBLISHABLE_KEY=                     # ← sandbox vault
MOOSYL_WEBHOOK_SECRET=                      # ← sandbox vault (NOT production)
MOOSYL_FEE_PERCENT=1

STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# ── EMAIL (staging console backend) ───────────────────────────────────────────

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Yala Staging <staging-noreply@yalataxi.live>

# ── MONITORING ───────────────────────────────────────────────────────────────

SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.2

# ── APP ──────────────────────────────────────────────────────────────────────

APP_FEE_PERCENT=30
PRIVATE_CALL_NUMBER=+22245000002
