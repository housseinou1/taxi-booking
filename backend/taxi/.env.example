DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret
DJANGO_ALLOWED_HOSTS=api.yourdomain.com,your-backend-host.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com,https://yourdomain.com,https://www.yourdomain.com
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL_REQUIRE=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
APP_FEE_PERCENT=30
PRIVATE_CALL_NUMBER=+22245000001

# Mobile money and bank provider credentials.
# Fill these with official production credentials when Bankily, Masravi,
# Seddad, or bank payout APIs are approved for your business.
BANKILY_MERCHANT_ID=
BANKILY_API_KEY=
BANKILY_WEBHOOK_SECRET=
MASRAVI_MERCHANT_ID=
MASRAVI_API_KEY=
MASRAVI_WEBHOOK_SECRET=
SEDDAD_MERCHANT_ID=
SEDDAD_API_KEY=
SEDDAD_WEBHOOK_SECRET=
BANK_PAYOUT_API_KEY=

# Optional production services.
GOOGLE_MAPS_API_KEY=
WAZE_DEEPLINK_ENABLED=True
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=

# Yala Support AI. Keep the API key only on the backend server.
YALA_AI_ENABLED=True
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Phone verification. Use "http" in production with your SMS provider.
YALA_SMS_PROVIDER=console
YALA_SMS_API_URL=
YALA_SMS_API_KEY=
YALA_SMS_SENDER=Yala

# Delivery notifications (Phase 2+)
YALA_MASKED_CALL_RELAY=
DELIVERY_GEOFENCE_RADIUS_KM=0.5
DELIVERY_LOCATION_MIN_INTERVAL_SECONDS=15
DELIVERY_LOCATION_MIN_DISTANCE_METERS=50
