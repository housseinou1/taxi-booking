# ═══════════════════════════════════════════════════════════════════════════════
# YALA PRODUCTION ENVIRONMENT VARIABLES
# Domain: yalataxi.live
# ═══════════════════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
# 1. Copy this file to .env.production
# 2. Replace ALL placeholder values marked with ← REQUIRED
# 3. Ensure POSTGRES_PASSWORD matches the password in DATABASE_URL
# 4. Never commit the filled .env.production to version control
#
# ═══════════════════════════════════════════════════════════════════════════════


# ── DJANGO CORE ───────────────────────────────────────────────────────────────

# Cryptographic signing key for sessions, tokens, and CSRF.
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=                          # ← REQUIRED (50+ random characters)

# Must be False in production. Enables debug pages and disables security.
DJANGO_DEBUG=False

# Comma-separated list of domains that Django will serve.
# Must include all domains pointing to this server.
DJANGO_ALLOWED_HOSTS=yalataxi.live,www.yalataxi.live,api.yalataxi.live


# ── DATABASE (PostgreSQL) ─────────────────────────────────────────────────────

# Full connection URL. Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# The PASSWORD here MUST match POSTGRES_PASSWORD in docker-compose.yml
DATABASE_URL=postgres://yala_user:YOUR_STRONG_PASSWORD@postgres:5432/yala_db  # ← REQUIRED

# Set True if connecting to external managed DB (RDS, Cloud SQL) over SSL.
# Set False for internal Docker network connections.
DATABASE_SSL_REQUIRE=False


# ── REDIS ─────────────────────────────────────────────────────────────────────

# Redis connection URL. Used for Django Channels (WebSocket) and cache (rate limiting).
# "redis" is the Docker Compose service name.
REDIS_URL=redis://redis:6379/0


# ── CORS & CSRF ───────────────────────────────────────────────────────────────

# Must be False in production. Only allow specific origins.
CORS_ALLOW_ALL_ORIGINS=False

# Comma-separated list of origins allowed to make cross-origin requests.
# Must include the frontend URL with https:// prefix.
CORS_ALLOWED_ORIGINS=https://yalataxi.live,https://www.yalataxi.live,https://api.yalataxi.live,capacitor://localhost,http://localhost,https://localhost

# Comma-separated list of origins trusted for CSRF token validation.
# Must match CORS_ALLOWED_ORIGINS.
CSRF_TRUSTED_ORIGINS=https://yalataxi.live,https://www.yalataxi.live,https://api.yalataxi.live


# ── HTTPS / SECURITY ─────────────────────────────────────────────────────────

# Redirect all HTTP requests to HTTPS.
# Set False if your reverse proxy (Render, Railway) handles SSL termination.
SECURE_SSL_REDIRECT=True

# HTTP Strict Transport Security duration in seconds (1 year = 31536000).
SECURE_HSTS_SECONDS=31536000

# Apply HSTS to all subdomains.
SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# Allow browser to preload HSTS (submit to hstspreload.org).
SECURE_HSTS_PRELOAD=True


# ── EMAIL (SMTP) ─────────────────────────────────────────────────────────────

# SMTP backend for sending real emails (password reset, notifications).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP server hostname. Use smtp.gmail.com for Gmail, or your provider's server.
EMAIL_HOST=smtp.gmail.com

# SMTP port. 587 for TLS, 465 for SSL.
EMAIL_PORT=587

# Enable TLS encryption for SMTP connection.
EMAIL_USE_TLS=True

# SMTP authentication username (your email address).
EMAIL_HOST_USER=                            # ← REQUIRED (e.g., noreply@yala.mr)

# SMTP authentication password.
# For Gmail: use an App Password (not your account password).
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=                        # ← REQUIRED

# The "From" address shown in outgoing emails.
DEFAULT_FROM_EMAIL=Yala <noreply@yalataxi.live>


# ── FRONTEND ──────────────────────────────────────────────────────────────────

# Base URL of the frontend app. Used in email templates for links.
FRONTEND_URL=https://yalataxi.live


# ── STRIPE (Payments) ─────────────────────────────────────────────────────────

# Stripe secret key (server-side). Starts with sk_live_ for production.
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=                          # ← REQUIRED (sk_live_...)

# Stripe publishable key (client-side). Starts with pk_live_ for production.
STRIPE_PUBLIC_KEY=                          # ← REQUIRED (pk_live_...)


# ── PUSH NOTIFICATIONS (Web Push / VAPID) ────────────────────────────────────

# VAPID private key for web push notifications.
# Generate: npx web-push generate-vapid-keys
# Optional: app works without push notifications.
PUSH_PRIVATE_KEY=                           # ← OPTIONAL

# VAPID public key (shared with frontend for push subscription).
PUSH_PUBLIC_KEY=                            # ← OPTIONAL

# Contact email for VAPID (required if using push).
PUSH_CLAIMS_EMAIL=mailto:admin@yalataxi.live


# ── MONITORING (Sentry) ──────────────────────────────────────────────────────

# Sentry DSN for error tracking and performance monitoring.
# Get from: https://sentry.io → Project → Settings → Client Keys
# Leave empty to disable Sentry.
SENTRY_DSN=                                 # ← RECOMMENDED

# Sentry environment tag (production / staging).
SENTRY_ENVIRONMENT=production

# Sample rate for performance tracing (0.0 to 1.0). 0.1 = 10% of transactions.
SENTRY_TRACES_SAMPLE_RATE=0.1


# ── APP SETTINGS ──────────────────────────────────────────────────────────────

# Platform commission percentage on ride fares (30 = 30%).
APP_FEE_PERCENT=30

# Private call relay number for driver-rider calls (Mauritania format).
PRIVATE_CALL_NUMBER=+22245000001
