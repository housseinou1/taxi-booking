# ── Django ─────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=CHANGE-ME-generate-with-python-secrets-token-urlsafe-50
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yala.mr,www.yala.mr,api.yala.mr

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://yala_user:YOUR_POSTGRES_PASSWORD@postgres:5432/yala_db
DATABASE_SSL_REQUIRE=False

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS & CSRF ───────────────────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://yala.mr,https://www.yala.mr
CSRF_TRUSTED_ORIGINS=https://yala.mr,https://www.yala.mr

# ── Security ──────────────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Yala <noreply@yala.mr>

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=https://yala.mr

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLIC_KEY=pk_live_xxx

# ── Push Notifications ────────────────────────────────────────────────────────
PUSH_PRIVATE_KEY=
PUSH_PUBLIC_KEY=
PUSH_CLAIMS_EMAIL=mailto:admin@yala.mr

# ── App Settings ──────────────────────────────────────────────────────────────
APP_FEE_PERCENT=30
PRIVATE_CALL_NUMBER=+22245000001
