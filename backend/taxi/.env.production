# ── Production Environment Variables ──────────────────────────────────────────
# Copy this to .env on your production server and fill in real values.

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET_KEY_HERE
DJANGO_ALLOWED_HOSTS=api.sakhoexpress.com,sakhoexpress.com

# Database (PostgreSQL)
DATABASE_URL=postgres://sakho:YOUR_DB_PASSWORD@localhost:5432/sakho_express
DATABASE_SSL_REQUIRE=True

# Redis (for WebSocket channel layer)
REDIS_URL=redis://localhost:6379/0

# CORS & CSRF
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://sakhoexpress.com,https://www.sakhoexpress.com
CSRF_TRUSTED_ORIGINS=https://api.sakhoexpress.com,https://sakhoexpress.com

# Frontend URL (for email links)
FRONTEND_URL=https://sakhoexpress.com

# SSL
SECURE_SSL_REDIRECT=True

# Stripe
STRIPE_SECRET_KEY=sk_live_YOUR_LIVE_KEY
STRIPE_PUBLIC_KEY=pk_live_YOUR_LIVE_KEY

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Sakho Express <noreply@sakhoexpress.com>

# Push Notifications (VAPID keys)
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_CLAIMS_EMAIL=mailto:admin@sakhoexpress.com

# App settings
APP_FEE_PERCENT=30
PRIVATE_CALL_NUMBER=+22245000001
