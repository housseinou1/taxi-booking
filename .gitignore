# Extra mobile build artifacts tracked during prior builds
rider-app/rider-apk/
release/device-qa*

# Agent scratch / task reports and local verification artefacts. These are working
# notes, not application code, and were previously polluting the reviewable diff.
.agents/**
!.agents/.gitkeep
