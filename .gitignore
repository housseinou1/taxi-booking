# Environment files
.env
.env.*
!.env.example
!.env.*.example
!.env.production.template
!.env.production.example
!.env.pilot.template
!.env.pilot.example
firebase-service-account.json
**/firebase-service-account.json
# Local credential files for operator/QA scripts (e.g. scripts/qa-credentials.env);
