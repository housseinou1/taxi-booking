*.env
!*.env.example

# Android keystores and signing credentials — NEVER commit these
signing/
driver-app/android/driver-signing.properties
rider-app/android/rider-signing.properties
delivery-app/android/delivery-signing.properties
*.jks
*.keystore
*.p12

# Virtual environments
venv/
env/
.venv/
.codex-test-venv/

# Python
__pycache__/
*.pyc
*.pyo

# Node
node_modules/

# Build outputs
frontend/build/
driver-app/www/
rider-app/www/
delivery-app/www/
admin-app/www/

